<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MySql.EntityFrameworkCore" Version="9.0.9" />
    <PackageReference Include="Serilog" Version="4.3.0" />
  </ItemGroup>

  <Target Name="PreBuildScript" BeforeTargets="PreBuildEvent">
    <Exec Command="echo Formatting code..." />
    <Exec Command="dotnet format &quot;$(ProjectPath)&quot; --include-generated" />
  </Target>

</Project>