COMPOSE_PROJECT_NAME=moneygestor

APP_SETTINGS_FILE=./settings.json

# MySQL bootstrap: used only when mysql-data is empty.
# Replace both passwords before first startup. Keep MYSQL_PASSWORD distinct from root.
# Match MYSQL_DATABASE, MYSQL_USER and MYSQL_PASSWORD in the application JSON.
# Quote values containing $ with single quotes to prevent Compose interpolation.
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=moneygestor_db
MYSQL_USER=moneygestor_user
MYSQL_PASSWORD=CHANGE_ME_IN_PRODUCTION
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_PORT=3306

BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=5000
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000

TRANSFER_UID=0
TRANSFER_GID=0

ARCHIVE_DIRECTORY=./artifacts/archives
IMPORT_ARCHIVE_PATH=./artifacts/archives/import.zip
MONEYGESTOR_MAINTENANCE_CONFIRMED=false
